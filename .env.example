# Copy to .env and fill in locally. Never commit the filled-in file.

# xmemory: durable learning memory.
XMEM_API_KEY=
XMEM_INSTANCE_ID=
# Defaults to https://api.xmemory.ai when unset.
XMEM_BASE_URL=

# The benchmark needs two instances so a clean run cannot see what a trained one learned.
XMEM_INSTANCE_ID_CLEAN=
XMEM_INSTANCE_ID_TRAINED=

# The model the Promotion Agent asks for a discount. Not yet wired.
DECISION_MODEL=

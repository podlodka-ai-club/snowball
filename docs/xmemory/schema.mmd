    E -->|creates / updates lesson| L
    L -->|top relevant lessons| A["Promotion Agent"]

    classDef entity fill:#ffffff,stroke:#cbd5e1,stroke-width:2px,color:#0f172a;
    classDef memory fill:#f5f3ff,stroke:#8b5cf6,stroke-width:2px,color:#0f172a;
    classDef actor fill:#eff6ff,stroke:#3b82f6,stroke-width:2px,color:#0f172a;
    classDef human fill:#fff7ed,stroke:#f59e0b,stroke-width:2px,color:#0f172a;

    class S entity;
    class C,L memory;
    class E,A actor;
    class H human;
